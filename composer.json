{
    "name": "cargo/car-rental",
    "description": "CarGO Car Rental Management System",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "files": [
            "db_connect.php",
            "includes/security.php",
            "util/car_archive.php",
            "util/car_display.php",
            "util/car_image.php",
            "util/booking.php",
            "util/payment.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
