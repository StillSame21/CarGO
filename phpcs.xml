<?xml version="1.0"?>
<ruleset name="CarGO">
    <description>PSR-12 coding standard for CarGO.</description>

    <arg name="colors"/>
    <arg value="p"/>

    <!-- Warnings are advisory: this is a view-heavy app with inline markup.
         Only PSR-12 errors should fail the build. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <rule ref="PSR12"/>

    <file>admin</file>
    <file>customer</file>
    <file>util</file>
    <file>includes</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
</ruleset>
