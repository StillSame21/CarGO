php_value display_errors Off
php_value mbstring.http_input auto
php_value date.timezone Asia/Kuala_Lumpur

DirectoryIndex index.php

RewriteEngine On
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

<IfModule mod_expires.c>
    ExpiresActive On
    <FilesMatch "\.(jpg|jpeg|png|gif|webp)$">
        ExpiresDefault "access plus 30 days"
    </FilesMatch>
</IfModule>

# Car image filenames carry a random 16-hex prefix (see
# util/car_image.php: buildCarImageFilename) and derivative widths are
# baked into the filename, so a given URL's content never changes -
# "immutable" lets the browser skip the revalidation request entirely,
# not just shorten its TTL.
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>
